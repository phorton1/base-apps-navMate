<?xml version="1.0" encoding="utf-8" ?>
<!--
  seed.gpx -OpenCPN test fixture for the navMate `ocpn` module.

  Import into a CLEAN OpenCPN (empty navobj.db), then snapshot navobj.db and
  capture the plugin's inventory POST.  Authored to exercise the ocpn identity
  and fidelity matrix; every object is annotated below.  Non-ASCII test data is
  written as XML numeric entities so this file stays ASCII while OpenCPN's parser
  decodes the real codepoints (R3 codepoint-equality).

  Objects:
    BarillasMarina  navMate-ORIGIN mark. GUID = navIdentity synth of DB uuid
                    9e4e10cc5e03093e ([IsolatedWP1]).  Ingest must reverse it
                    table-free (MAGIC) and reconcile to the existing DB uuid,
                    NO 0x4f mint.
    OcpnHazard      foreign mark, icon 'Hazard-Danger' (maps to sym 7).
                    MULTI-LINE comment -wire newline round-trip + newline->space
                    at the E80/FSH boundary on cross-spoke paste.
    DeepReefFar     foreign mark, icon 'Info-Fish-Reef' (many-to-one: syms
                    27/28/29 -> reverse folds to first, sym 27).  LONG comment
                    (>255) -no truncation on ocpn, truncates cross-spoke.
    CafeNandu       foreign mark, icon 'Marks-Beacon-Red' (NOT in the 36-map ->
                    catch-all default sym 2).  NON-ASCII name + comment (R3).
    SharedAnchor    foreign mark that ALSO appears as rtept in OcpnTestRoute with
                    the SAME GUID -the shared-point / ~84-double-count reconcile
                    (one nav uuid) + manifestation XOR.
    OcpnTestRoute   foreign route, full-embed: SharedAnchor (shared), RteMid
                    (route-owned pure vertex), RteEnd.
    OcpnTestTrack   foreign track with timestamped points + a display color.
-->
<gpx version="1.1" creator="OpenCPN" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.topografix.com/GPX/1/1" xmlns:gpxx="http://www.garmin.com/xmlschemas/GpxExtensions/v3" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd http://www.garmin.com/xmlschemas/GpxExtensionsv3.xsd" xmlns:opencpn="http://www.opencpn.org">
  <wpt lat="9.340000000" lon="-82.240000000">
    <name>BarillasMarina</name>
    <desc>navMate-origin round-trip anchor.</desc>
    <sym>Symbol-Circle-Red</sym>
    <type>WPT</type>
    <extensions>
      <opencpn:guid>9e4e10cc-6e61-4764-8d61-5e03093e7465</opencpn:guid>
      <opencpn:shared>1</opencpn:shared>
    </extensions>
  </wpt>
  <wpt lat="9.351200000" lon="-82.245600000">
    <name>OcpnHazard</name>
    <desc>Reef awash near low water.
Approach only on a rising tide with local knowledge.</desc>
    <sym>Hazard-Danger</sym>
    <type>WPT</type>
    <extensions>
      <opencpn:guid>3f2a9c10-7b4e-4d21-9e88-1a2b3c4d5e6f</opencpn:guid>
      <opencpn:shared>1</opencpn:shared>
    </extensions>
  </wpt>
  <wpt lat="9.362400000" lon="-82.251200000">
    <name>DeepReefFar</name>
    <desc>Outer reef edge dropping into blue water; strong tidal set across the pass on the ebb. Anchor sand patch bears roughly north-northeast about two hundred metres, but holding is uncertain in fresh trades. Dive the wall on slack water only, and watch for the eddy line that forms off the point when the current runs hard.</desc>
    <sym>Info-Fish-Reef</sym>
    <type>WPT</type>
    <extensions>
      <opencpn:guid>5c8e21b0-3a9f-4e11-b077-9d4c1e2f3a4b</opencpn:guid>
      <opencpn:shared>1</opencpn:shared>
    </extensions>
  </wpt>
  <wpt lat="9.333300000" lon="-82.238800000">
    <name>Caf&#233; &#209;and&#250;</name>
    <desc>Se&#241;alizaci&#243;n n&#225;utica &#8212; cuidado con la corriente. Caf&#233; y niebla al amanecer</desc>
    <sym>Marks-Beacon-Red</sym>
    <type>WPT</type>
    <extensions>
      <opencpn:guid>7a1d44e2-9b3c-4f56-8a12-2b3c4d5e6f70</opencpn:guid>
      <opencpn:shared>1</opencpn:shared>
    </extensions>
  </wpt>
  <wpt lat="9.345000000" lon="-82.242000000">
    <name>SharedAnchor</name>
    <desc>Good holding in sand; also the start vertex of OcpnTestRoute.</desc>
    <sym>Symbol-Anchor3</sym>
    <type>WPT</type>
    <extensions>
      <opencpn:guid>9d4c8f21-6a5b-4c3d-8e2f-1a0b9c8d7e6f</opencpn:guid>
      <opencpn:shared>1</opencpn:shared>
    </extensions>
  </wpt>
  <rte>
    <name>OcpnTestRoute</name>
    <desc>Foreign route with a shared start point.</desc>
    <extensions>
      <opencpn:guid>b2c3d4e5-1f2a-4b3c-8d4e-5f6a7b8c9d0e</opencpn:guid>
      <opencpn:viz>1</opencpn:viz>
      <opencpn:sharedWPviz>1</opencpn:sharedWPviz>
      <opencpn:start>SharedAnchor</opencpn:start>
      <opencpn:end>RteEnd</opencpn:end>
      <gpxx:RouteExtension>
        <gpxx:IsAutoNamed>false</gpxx:IsAutoNamed>
        <gpxx:DisplayColor>Magenta</gpxx:DisplayColor>
      </gpxx:RouteExtension>
    </extensions>
    <rtept lat="9.345000000" lon="-82.242000000">
      <name>SharedAnchor</name>
      <sym>Symbol-Anchor3</sym>
      <type>WPT</type>
      <extensions>
        <opencpn:guid>9d4c8f21-6a5b-4c3d-8e2f-1a0b9c8d7e6f</opencpn:guid>
        <opencpn:shared>1</opencpn:shared>
      </extensions>
    </rtept>
    <rtept lat="9.348000000" lon="-82.250000000">
      <name>RteMid</name>
      <sym>square</sym>
      <type>WPT</type>
      <extensions>
        <opencpn:guid>c3d4e5f6-2a3b-4c5d-8e6f-7a8b9c0d1e2f</opencpn:guid>
      </extensions>
    </rtept>
    <rtept lat="9.352000000" lon="-82.255000000">
      <name>RteEnd</name>
      <sym>Symbol-Square-Red</sym>
      <type>WPT</type>
      <extensions>
        <opencpn:guid>d4e5f6a7-3b4c-4d5e-8f70-8b9c0d1e2f30</opencpn:guid>
      </extensions>
    </rtept>
  </rte>
  <trk>
    <name>OcpnTestTrack</name>
    <desc>Foreign track, four timestamped points.</desc>
    <extensions>
      <opencpn:guid>e5f6a7b8-4c5d-4e6f-8071-9c0d1e2f3041</opencpn:guid>
      <opencpn:viz>1</opencpn:viz>
      <gpxx:TrackExtension>
        <gpxx:DisplayColor>Magenta</gpxx:DisplayColor>
      </gpxx:TrackExtension>
    </extensions>
    <trkseg>
      <trkpt lat="9.344000000" lon="-82.241000000">
        <time>2024-03-01T14:00:00Z</time>
      </trkpt>
      <trkpt lat="9.346500000" lon="-82.244000000">
        <time>2024-03-01T14:05:00Z</time>
      </trkpt>
      <trkpt lat="9.349000000" lon="-82.248000000">
        <time>2024-03-01T14:10:00Z</time>
      </trkpt>
      <trkpt lat="9.351500000" lon="-82.252000000">
        <time>2024-03-01T14:15:00Z</time>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
